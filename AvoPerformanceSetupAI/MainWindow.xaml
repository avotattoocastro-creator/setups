<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AvoPerformanceSetupAI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvoPerformanceSetupAI"
    xmlns:views="using:AvoPerformanceSetupAI.Views"
    Title="AvoPerformanceSetupAI">

    <Grid Background="#FF0F1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="#FF0A1414" x:Name="TitleBarGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="⚡" FontSize="16" VerticalAlignment="Center" Foreground="#FF00B4B4" Margin="0,0,8,0"/>
                <TextBlock Text="AvoPerformanceSetupAI" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFE0F0F0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Tab View -->
        <TabView Grid.Row="1" x:Name="MainTabView"
                 Background="#FF0F1A1A"
                 TabWidthMode="Equal"
                 IsAddTabButtonVisible="False"
                 SelectionChanged="MainTabView_SelectionChanged">
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBackground" Color="#FF0F1A1A" />
            </TabView.Resources>

            <TabViewItem x:Name="TabConfiguracion" Header="Configuración" IsClosable="False">
                <views:ConfiguracionPage />
            </TabViewItem>

            <TabViewItem x:Name="TabSesiones" Header="Sesiones" IsClosable="False">
                <views:SesionesPage />
            </TabViewItem>

            <TabViewItem x:Name="TabControl" Header="Control" IsClosable="False">
                <views:ControlPage />
            </TabViewItem>

            <TabViewItem x:Name="TabTerminal" Header="🖥 Terminal" IsClosable="False">
                <views:TerminalPage />
            </TabViewItem>

            <TabViewItem x:Name="TabAiAssistant" Header="🤖 IA Asistente" IsClosable="False">
                <views:AiAssistantPage />
            </TabViewItem>

            <TabViewItem x:Name="TabTelemetry" Header="📡 Telemetría" IsClosable="False">
                <views:TelemetryPage />
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
