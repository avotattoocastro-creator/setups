<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AvoPerformanceSetupAI.Views.TelemetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AvoPerformanceSetupAI.Models"
    xmlns:converters="using:AvoPerformanceSetupAI.Converters"
    xmlns:local="using:AvoPerformanceSetupAI.Reference"
    xmlns:telemetry="using:AvoPerformanceSetupAI.Telemetry"
    Background="Transparent"
    RequestedTheme="Dark">

    <Page.Resources>

        <!-- ═══ Telemetry channel card — real values ═══ -->
        <DataTemplate x:Key="RealChannelCard" x:DataType="models:TelemetryChannel">
            <Border Background="#FF182828"
                    BorderBrush="#FF2E4040" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="3">
                <StackPanel MinWidth="88" Spacing="2">
                    <TextBlock Text="{x:Bind Name}"
                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                               Foreground="#FF607878"/>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{x:Bind RealDisplay, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                   Foreground="#FFE0F8F8"/>
                        <TextBlock Text="{x:Bind Unit}"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#FF607878" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind DeltaDisplay, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#FFFFA040"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ Telemetry channel card — ideal values ═══ -->
        <DataTemplate x:Key="IdealChannelCard" x:DataType="models:TelemetryChannel">
            <Border Background="#FF0F2418"
                    BorderBrush="#FF1E4030" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="3">
                <StackPanel MinWidth="88" Spacing="2">
                    <TextBlock Text="{x:Bind Name}"
                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                               Foreground="#FF607878"/>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{x:Bind IdealDisplay, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                   Foreground="#FF00E676"/>
                        <TextBlock Text="{x:Bind Unit}"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#FF607878" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="objetivo"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#FF3A6050"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ Converters ═══ -->
        <converters:FloatToPercentConverter x:Key="FloatToPercent"/>
        <converters:NotBoolConverter x:Key="NotBoolConverter"/>
        <converters:AcStatusToForegroundConverter x:Key="AcStatusToForeground"/>
        <converters:AcStatusToBackgroundConverter x:Key="AcStatusToBackground"/>
        <converters:AcStatusToBorderConverter x:Key="AcStatusToBorder"/>

        <!-- ═══ Analysis terminal row ═══ -->
        <DataTemplate x:Key="AnalysisEntryRow" x:DataType="models:AnalysisEntry">
            <Grid Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Time}"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#FF607070" VerticalAlignment="Top"/>
                <Border Grid.Column="1"
                        Background="#FF1A3030" CornerRadius="3"
                        Padding="4,1" Margin="4,1,4,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind Tag}"
                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                               Foreground="#FF00D4B4" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{x:Bind Message}"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#FFB0D0D0"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Main layout: header / real panel / ideal panel / analysis row
         ═══════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="TelemetryRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- reconnect suggestion banner -->
            <RowDefinition Height="Auto"/>  <!-- real telemetry -->
            <RowDefinition Height="Auto"/>  <!-- ideal telemetry -->
            <RowDefinition Height="Auto"/>  <!-- live analysis panel -->
            <RowDefinition Height="2*"/>    <!-- analysis terminals -->
            <RowDefinition Height="*"/>     <!-- corner phase summaries -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#FF0A1414"
                BorderBrush="#FF2E4040" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + live status + lap times + lap position -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📡" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Telemetría" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFE0F0F0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" Foreground="#FF00B4B4"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Vuelta:" Foreground="#FF8AABAB" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.LapTimeReal, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                   Foreground="#FFE0F8F8"/>
                        <TextBlock Text="{x:Bind ViewModel.LapDelta, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" Foreground="#FFFFA040"/>
                        <TextBlock Text="/ Ideal:" Foreground="#FF8AABAB" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.LapTimeIdeal, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                   Foreground="#FF00E676"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.LapPositionText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                   Foreground="#FF00E676" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- AC shared-memory connection badge (color changes with status) -->
                    <Border Background="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay, Converter={StaticResource AcStatusToBackground}}"
                            BorderBrush="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay, Converter={StaticResource AcStatusToBorder}}"
                            BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay, Converter={StaticResource AcStatusToForeground}}"/>
                    </Border>
                    <!-- Source selector: segmented [SIMULACIÓN] / [ASSETTO CORSA REAL] -->
                    <Border Background="#FF0A1414" BorderBrush="#FF2E4040" BorderThickness="1"
                            CornerRadius="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="SIMULACIÓN"
                                          IsChecked="{x:Bind ViewModel.IsSimulationSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.IsSimulating, Mode=OneWay, Converter={StaticResource NotBoolConverter}}"
                                          FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                          Padding="10,3" CornerRadius="4,0,0,4" MinWidth="0"
                                          BorderThickness="0"/>
                            <ToggleButton Content="ASSETTO CORSA REAL"
                                          IsChecked="{x:Bind ViewModel.IsAcSourceSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.IsSimulating, Mode=OneWay, Converter={StaticResource NotBoolConverter}}"
                                          FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                          Padding="10,3" CornerRadius="0,4,4,0" MinWidth="0"
                                          BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="▶ Iniciar"
                            Command="{x:Bind ViewModel.StartSimulationCommand}"
                            Background="#FF00B4B4" Foreground="White"
                            CornerRadius="6" Padding="12,4" FontSize="12"/>
                    <Button Content="⏹ Pausar"
                            Command="{x:Bind ViewModel.StopSimulationCommand}"
                            Background="#FF2A3A3A" Foreground="#FFB0C8C8"
                            CornerRadius="6" Padding="12,4" FontSize="12"/>
                    <Button Content="🗑 Limpiar"
                            Command="{x:Bind ViewModel.ClearAnalysisCommand}"
                            Background="#FF1E2A2A" Foreground="#FF8AABAB"
                            BorderBrush="#FF2E4040" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                </StackPanel>

                <!-- ── Reference lap toolbar (Row 1, all columns) ──────────── -->
                <Border Grid.Row="1" Grid.ColumnSpan="3"
                        BorderBrush="#FF1A3030" BorderThickness="0,1,0,0"
                        Margin="0,8,0,0" Padding="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Recording controls -->
                        <Button Content="⏺ Grabar vuelta ideal"
                                Command="{x:Bind ViewModel.StartRecordingCommand}"
                                Background="#FF1A3030" Foreground="#FF00D4B4"
                                BorderBrush="#FF2E5050" BorderThickness="1"
                                CornerRadius="5" Padding="10,3" FontSize="11"/>
                        <Button Content="✖ Cancelar grabación"
                                Command="{x:Bind ViewModel.CancelRecordingCommand}"
                                Background="#FF2A1A1A" Foreground="#FFFF6060"
                                BorderBrush="#FF4A2020" BorderThickness="1"
                                CornerRadius="5" Padding="10,3" FontSize="11"/>
                        <!-- Recording progress bar -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}">
                            <TextBlock Text="REC" FontFamily="Consolas" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#FFFF4040"
                                       VerticalAlignment="Center"/>
                            <ProgressBar Value="{x:Bind ViewModel.RecordingProgress, Mode=OneWay}"
                                         Maximum="1" Width="120" Height="7"
                                         Background="#FF1A3030" Foreground="#FFFF4040"/>
                        </StackPanel>
                        <!-- Import CSV -->
                        <Button Content="📂 Importar CSV ideal"
                                Click="OnImportCsvClicked"
                                Background="#FF1A2030" Foreground="#FF80B4E0"
                                BorderBrush="#FF2A3850" BorderThickness="1"
                                CornerRadius="5" Padding="10,3" FontSize="11"/>
                        <!-- Reference selector -->
                        <ComboBox PlaceholderText="Seleccionar Ideal"
                                  ItemsSource="{x:Bind ViewModel.SavedReferences}"
                                  SelectedItem="{x:Bind ViewModel.SelectedReference, Mode=TwoWay}"
                                  MinWidth="220" FontFamily="Consolas" FontSize="10"
                                  Background="#FF0A1414" BorderBrush="#FF2E4040">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ReferenceLapMeta">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontFamily="Consolas" FontSize="10"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Active reference label -->
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveReferenceName, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#FF00E676"/>
                            <TextBlock Text="{x:Bind ViewModel.ReferenceSource, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ── Reconnect suggestion banner ─────────────────────────────── -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.ShowSwitchToSimulationPrompt, Mode=OneWay}"
                 Severity="Warning"
                 Title="Assetto Corsa no responde"
                 Message="10 intentos de reconexión fallaron. ¿Cambiar a modo Simulación?"
                 IsClosable="False"
                 Margin="8,4">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Seguir intentando"
                            Command="{x:Bind ViewModel.DismissSwitchToSimulationCommand}"
                            Background="#FF2A3A3A" Foreground="#FFB0C8C8"
                            CornerRadius="4" Padding="10,3" FontSize="11"/>
                    <Button Content="Cambiar a Simulación"
                            Command="{x:Bind ViewModel.ConfirmSwitchToSimulationCommand}"
                            Background="#FF00B4B4" Foreground="White"
                            CornerRadius="4" Padding="10,3" FontSize="11"/>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- ── Real telemetry panel ────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#FF0F1A1A"
                BorderBrush="#FF2E4040" BorderThickness="0,0,0,1"
                Padding="8,8,8,4">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <TextBlock Text="📊" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="TELEMETRÍA REAL"
                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FF00B4B4" VerticalAlignment="Center"/>
                    <TextBlock Text="tiempo real — delta naranja = Real − Ideal"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#FF607070" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Channels}"
                                  ItemTemplate="{StaticResource RealChannelCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ── Ideal telemetry panel ───────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="#FF0A1414"
                BorderBrush="#FF2E4040" BorderThickness="0,0,0,1"
                Padding="8,8,8,4">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <TextBlock Text="🎯" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="TELEMETRÍA IDEAL"
                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FF00E676" VerticalAlignment="Center"/>
                    <TextBlock Text="valores objetivo ajustados por posición en pista"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#FF607070" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Channels}"
                                  ItemTemplate="{StaticResource IdealChannelCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ── Live Analysis Panel ────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="#FF0F1A1A"
                BorderBrush="#FF2E4040" BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Status card: Speed / Gear / RPM / Phase / Corner ── -->
                <Border Grid.Column="0" Background="#FF182828"
                        BorderBrush="#FF2E4040" BorderThickness="1"
                        CornerRadius="6" Padding="10,6">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🏎" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="ANÁLISIS EN VIVO"
                                       FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#FF00B4B4" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Speed / Gear / RPM -->
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel Spacing="1">
                                <TextBlock Text="VEL" FontFamily="Consolas" FontSize="9" Foreground="#FF607878"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.Channels[0].RealDisplay, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                               Foreground="#FFE0F8F8"/>
                                    <TextBlock Text="km/h" FontFamily="Consolas" FontSize="9"
                                               Foreground="#FF607878" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="1">
                                <TextBlock Text="MARCHA" FontFamily="Consolas" FontSize="9" Foreground="#FF607878"/>
                                <TextBlock Text="{x:Bind ViewModel.Channels[2].RealDisplay, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                           Foreground="#FFE0F8F8"/>
                            </StackPanel>
                            <StackPanel Spacing="1">
                                <TextBlock Text="RPM" FontFamily="Consolas" FontSize="9" Foreground="#FF607878"/>
                                <TextBlock Text="{x:Bind ViewModel.Channels[1].RealDisplay, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                           Foreground="#FFE0F8F8"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Phase + Corner direction + Duration -->
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel Spacing="1">
                                <TextBlock Text="FASE" FontFamily="Consolas" FontSize="9" Foreground="#FF607878"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentPhase, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF00D4B4"/>
                            </StackPanel>
                            <StackPanel Spacing="1">
                                <TextBlock Text="ÚLT. CURVA" FontFamily="Consolas" FontSize="9" Foreground="#FF607878"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.LastCornerDirection, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FF00D4B4"/>
                                    <TextBlock Text="{x:Bind ViewModel.LastCornerDurationText, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="#FF607878" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Meters card: 5 progress bars with labels ── -->
                <Border Grid.Column="1" Background="#FF182828"
                        BorderBrush="#FF2E4040" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" MinWidth="264">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ÍNDICES ÚLT. CURVA"
                                   FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#FF00B4B4" Margin="0,0,0,2"/>
                        <!-- US Entry -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="US Entrada" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Maximum="1" Height="7" Margin="4,0"
                                         Value="{x:Bind ViewModel.LastCornerUndersteerEntry, Mode=OneWay}"
                                         Background="#FF1A3030" Foreground="#FFFFA040"/>
                            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FFFFA040" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LastCornerUndersteerEntry, Converter={StaticResource FloatToPercent}, Mode=OneWay}"/>
                        </Grid>
                        <!-- US Mid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="US Medio" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Maximum="1" Height="7" Margin="4,0"
                                         Value="{x:Bind ViewModel.LastCornerUndersteerMid, Mode=OneWay}"
                                         Background="#FF1A3030" Foreground="#FFFFA040"/>
                            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FFFFA040" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LastCornerUndersteerMid, Converter={StaticResource FloatToPercent}, Mode=OneWay}"/>
                        </Grid>
                        <!-- US Exit -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="US Salida" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Maximum="1" Height="7" Margin="4,0"
                                         Value="{x:Bind ViewModel.LastCornerUndersteerExit, Mode=OneWay}"
                                         Background="#FF1A3030" Foreground="#FFFFA040"/>
                            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FFFFA040" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LastCornerUndersteerExit, Converter={StaticResource FloatToPercent}, Mode=OneWay}"/>
                        </Grid>
                        <!-- OS Entry -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OS Entrada" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Maximum="1" Height="7" Margin="4,0"
                                         Value="{x:Bind ViewModel.LastCornerOversteerEntry, Mode=OneWay}"
                                         Background="#FF1A3030" Foreground="#FFE04040"/>
                            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FFE04040" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LastCornerOversteerEntry, Converter={StaticResource FloatToPercent}, Mode=OneWay}"/>
                        </Grid>
                        <!-- OS Exit -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OS Salida" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Maximum="1" Height="7" Margin="4,0"
                                         Value="{x:Bind ViewModel.LastCornerOversteerExit, Mode=OneWay}"
                                         Background="#FF1A3030" Foreground="#FFE04040"/>
                            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FFE04040" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LastCornerOversteerExit, Converter={StaticResource FloatToPercent}, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Live vs Ideal delta card ── -->
                <Border Grid.Column="1" Background="#FF0F1A10"
                        BorderBrush="#FF1E4030" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" MinWidth="220"
                        Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                            <TextBlock Text="⚖" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="VS IDEAL"
                                       FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#FF00E676" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.ReferenceSummaryText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="#FFFFA040" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- ΔSpeed -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="ΔVel" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" Width="36" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LiveDeltaSpeedText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF00E676"/>
                        </StackPanel>
                        <!-- ΔBrake -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="ΔFren" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" Width="36" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LiveDeltaBrakeText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="#FFFFA040"/>
                        </StackPanel>
                        <!-- ΔThrottle -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="ΔAcel" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" Width="36" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LiveDeltaThrottleText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF80E040"/>
                        </StackPanel>
                        <!-- ΔYawGain -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="ΔYaw" FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878" Width="36" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LiveDeltaYawGainText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="#FFE0B040"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Proposals panel (Single / Multi-Optimize toggle) ── -->
                <Border Grid.Column="3" Background="#FF0A1414"
                        BorderBrush="#FF2E4040" BorderThickness="1"
                        CornerRadius="6" Padding="8,6">
                    <StackPanel>

                        <!-- ── Panel header + mode toggle ── -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="💡" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="PROPUESTAS EN VIVO"
                                           FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#FF00B4B4" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Segmented mode toggle: [Single] [Multi-Optimize] -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                <ToggleButton Content="Single"
                                              FontFamily="Consolas" FontSize="9"
                                              Padding="8,2"
                                              IsChecked="{x:Bind ViewModel.IsSingleMode, Mode=TwoWay}"
                                              Background="#FF0F2828"
                                              Foreground="#FFB0D0D0"
                                              BorderBrush="#FF2E4040"
                                              CornerRadius="3,0,0,3"/>
                                <ToggleButton Content="Multi-Optimize"
                                              FontFamily="Consolas" FontSize="9"
                                              Padding="8,2"
                                              IsChecked="{x:Bind ViewModel.IsMultiMode, Mode=TwoWay}"
                                              Background="#FF0F2828"
                                              Foreground="#FFB0D0D0"
                                              BorderBrush="#FF2E4040"
                                              CornerRadius="0,3,3,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ── Driving mode toggle: [Sprint] [Endurance] ── -->
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                            <TextBlock Text="MODE"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="#FF607878"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ToggleButton Content="Sprint"
                                          FontFamily="Consolas" FontSize="9"
                                          Padding="10,2"
                                          IsChecked="{x:Bind ViewModel.IsSprintMode, Mode=TwoWay}"
                                          Background="#FF0F2828"
                                          Foreground="#FFFFA040"
                                          BorderBrush="#FF2E4040"
                                          CornerRadius="3,0,0,3"/>
                            <ToggleButton Content="Endurance"
                                          FontFamily="Consolas" FontSize="9"
                                          Padding="10,2"
                                          IsChecked="{x:Bind ViewModel.IsEnduranceMode, Mode=TwoWay}"
                                          Background="#FF0F2828"
                                          Foreground="#FF80E040"
                                          BorderBrush="#FF2E4040"
                                          CornerRadius="0,3,3,0"/>
                        </StackPanel>

                        <!-- ── Single-change proposals list ── -->
                        <ListView ItemsSource="{x:Bind ViewModel.Proposals}"
                                  SelectionMode="None" IsItemClickEnabled="False"
                                  MaxHeight="114"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind ViewModel.IsSingleMode, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Proposal">
                                    <Grid Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FF1A3030" CornerRadius="3"
                                                Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Section}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#FF00D4B4" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Parameter}"
                                                   FontFamily="Consolas" FontSize="10" Foreground="#FFB0D0D0"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Border Grid.Column="2" Background="#FF0F2010" CornerRadius="3"
                                                Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Delta}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#FF80E040" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{x:Bind ConfidenceDisplay}"
                                                   FontFamily="Consolas" FontSize="10" Foreground="#FFFFA040"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Reason}"
                                                   FontFamily="Consolas" FontSize="10" Foreground="#FF607878"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- ── Multi-optimize combination list ── -->
                        <ListView ItemsSource="{x:Bind ViewModel.CombinedProposals}"
                                  SelectionMode="Single"
                                  SelectedItem="{x:Bind ViewModel.SelectedCombinedProposal, Mode=TwoWay}"
                                  MaxHeight="160"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind ViewModel.IsMultiMode, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="telemetry:CombinedProposal">
                                    <Border Background="#FF0D1E1E" CornerRadius="4"
                                            Padding="6,4" Margin="0,2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: grouped change labels -->
                                            <TextBlock Grid.Row="0"
                                                       Text="{x:Bind ChangesDisplay}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#FF00D4B4"
                                                       TextWrapping="Wrap"/>

                                            <!-- Row 1: score delta + risk badge -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                        Spacing="8" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="Δscore"
                                                               FontFamily="Consolas" FontSize="9"
                                                               Foreground="#FF607878"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind ScoreDeltaDisplay}"
                                                               FontFamily="Consolas" FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#FF80E040"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind RiskDisplay}"
                                                           FontFamily="Consolas" FontSize="9"
                                                           Foreground="#FFFFA040"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Row 2: Test Combo button -->
                                            <Button Grid.Row="2"
                                                    Content="▶ Test Combo"
                                                    FontFamily="Consolas" FontSize="9"
                                                    Padding="8,2" Margin="0,3,0,0"
                                                    Background="#FF142828"
                                                    Foreground="#FF00B4B4"
                                                    BorderBrush="#FF2E5050"
                                                    CornerRadius="3"
                                                    Tag="{x:Bind}"
                                                    Click="OnTestComboClicked"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- ── Empty-state hint when multi mode has no combos yet ── -->
                        <TextBlock Text="No combinations yet — waiting for corner data…"
                                   FontFamily="Consolas" FontSize="9"
                                   Foreground="#FF3A5050"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Visibility="{x:Bind ViewModel.IsMultiEmptyState, Mode=OneWay}"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ── Three analysis terminals ───────────────────────────────────── -->
        <Grid Grid.Row="5" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Terminal 1: Car behaviour -->
            <Grid Grid.Column="0" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="#FF0A1414" BorderBrush="#FF2E4040"
                        BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🚗" FontSize="12"/>
                        <TextBlock Text="Comportamiento del Coche"
                                   FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF00B4B4"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        Background="#FF060E0E" BorderBrush="#FF2E4040"
                        BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                    <ScrollViewer x:Name="BehaviorScrollViewer"
                                  Padding="8" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.BehaviorLogs}"
                                      ItemTemplate="{StaticResource AnalysisEntryRow}"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Terminal 2: Driving time -->
            <Grid Grid.Column="1" Margin="4,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="#FF0A1414" BorderBrush="#FF2E4040"
                        BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⏱" FontSize="12"/>
                        <TextBlock Text="Análisis de Tiempo de Conducción"
                                   FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF00B4B4"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        Background="#FF060E0E" BorderBrush="#FF2E4040"
                        BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                    <ScrollViewer x:Name="DrivingScrollViewer"
                                  Padding="8" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DrivingLogs}"
                                      ItemTemplate="{StaticResource AnalysisEntryRow}"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Terminal 3: Setup improvement steps -->
            <Grid Grid.Column="2" Margin="4,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="#FF0A1414" BorderBrush="#FF2E4040"
                        BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔧" FontSize="12"/>
                        <TextBlock Text="Pasos de Mejora del Setup"
                                   FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF00B4B4"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        Background="#FF060E0E" BorderBrush="#FF2E4040"
                        BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                    <ScrollViewer x:Name="SetupScrollViewer"
                                  Padding="8" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SetupLogs}"
                                      ItemTemplate="{StaticResource AnalysisEntryRow}"/>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>

        <!-- ── Corner phase analysis terminal (full width) ────────────────── -->
        <Grid Grid.Row="6" Margin="8,4,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#FF0A1414" BorderBrush="#FF2E4040"
                    BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🏎" FontSize="12"/>
                    <TextBlock Text="Resumen de Fases de Curva"
                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FF00B4B4"/>
                    <TextBlock Text="segmentación por G lateral — análisis por curva detectada"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#FF607070" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Background="#FF060E0E" BorderBrush="#FF2E4040"
                    BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                <ScrollViewer x:Name="CornerScrollViewer"
                              Padding="8" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CornerLogs}"
                                  ItemTemplate="{StaticResource AnalysisEntryRow}"/>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Page>
