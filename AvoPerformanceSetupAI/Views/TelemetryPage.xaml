<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AvoPerformanceSetupAI.Views.TelemetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AvoPerformanceSetupAI.Models"
    Background="Transparent"
    RequestedTheme="Dark">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#FF0A1414"
                BorderBrush="#FF2E4040"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ConnectionDot, Mode=OneWay}"
                               FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Telemetría en Tiempo Real — Assetto Corsa"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFE0F0F0" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#FF2E4040" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.CarModel, Mode=OneWay}"
                               Foreground="#FF00B4B4" FontSize="13"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock Text="@" Foreground="#FF2E4040" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.TrackName, Mode=OneWay}"
                               Foreground="#FF8AABAB" FontSize="13"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🔍 Analizar ahora"
                        Command="{x:Bind ViewModel.AnalyzeNowCommand}"
                        Background="#FF1E2A2A"
                        Foreground="#FF8AABAB"
                        BorderBrush="#FF2E4040"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        FontSize="12"/>
            </Grid>
        </Border>

        <!-- ── Main content ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Live telemetry gauges ─────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <!-- Speed / Gear / RPM card -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🚗 Estado del Coche"
                                       FontWeight="SemiBold"
                                       Foreground="#FFE0F0F0" FontSize="13"/>

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Speed -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Velocidad"
                                               Foreground="#FF607070" FontSize="10"/>
                                    <TextBlock Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}"
                                               Foreground="#FF00D4B4"
                                               FontFamily="Consolas"
                                               FontSize="26" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Gear -->
                                <StackPanel Grid.Column="1" Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Marcha"
                                               Foreground="#FF607070" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <Border Background="#FF0F2020"
                                            BorderBrush="#FF2E4040"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="12,4">
                                        <TextBlock Text="{x:Bind ViewModel.GearText, Mode=OneWay}"
                                                   Foreground="#FFE0F0F0"
                                                   FontFamily="Consolas"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- RPM -->
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="RPM"
                                               Foreground="#FF607070" FontSize="10"/>
                                    <TextBlock Text="{x:Bind ViewModel.RpmText, Mode=OneWay}"
                                               Foreground="#FFB0D0D0"
                                               FontFamily="Consolas"
                                               FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Throttle / Brake card -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚡ Acelerador / Freno"
                                       FontWeight="SemiBold"
                                       Foreground="#FFE0F0F0" FontSize="13"/>

                            <!-- Throttle -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Gas"
                                           Foreground="#FF20B040" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1"
                                             Value="{x:Bind ViewModel.ThrottlePct, Mode=OneWay}"
                                             Minimum="0" Maximum="1"
                                             Foreground="#FF20B040"
                                             Background="#FF0F2020"
                                             Height="14" CornerRadius="4"/>
                            </Grid>

                            <!-- Brake -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Freno"
                                           Foreground="#FFFF4040" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1"
                                             Value="{x:Bind ViewModel.BrakePct, Mode=OneWay}"
                                             Minimum="0" Maximum="1"
                                             Foreground="#FFFF4040"
                                             Background="#FF0F2020"
                                             Height="14" CornerRadius="4"/>
                            </Grid>

                            <!-- Surface grip -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Grip pista:"
                                           Foreground="#FF607070" FontSize="11"/>
                                <TextBlock Text="{x:Bind ViewModel.SurfaceGripText, Mode=OneWay}"
                                           Foreground="#FFB0D0D0"
                                           FontFamily="Consolas" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tyre temperatures card (2×2 grid) -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🌡 Temperatura de Neumáticos  (FL/FR/RL/RR)"
                                       FontWeight="SemiBold"
                                       Foreground="#FFE0F0F0" FontSize="13"/>
                            <TextBlock Text="🔵 frío  🟡 calentando  🟢 óptimo (80-105°C)  🟠 caliente  🔴 excesivo"
                                       Foreground="#FF607070" FontSize="10"/>

                            <!-- Front row -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- FL -->
                                <Border Grid.Column="0"
                                        Background="#FF0F2020"
                                        BorderBrush="#FF2E4040"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TempIconFL, Mode=OneWay}"
                                                       FontSize="14"/>
                                            <TextBlock Text="Delantero Izq."
                                                       Foreground="#FF607070" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.TempFL, Mode=OneWay}"
                                                   Foreground="#FFB0D0D0"
                                                   FontFamily="Consolas"
                                                   FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- FR -->
                                <Border Grid.Column="1"
                                        Background="#FF0F2020"
                                        BorderBrush="#FF2E4040"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TempIconFR, Mode=OneWay}"
                                                       FontSize="14"/>
                                            <TextBlock Text="Delantero Der."
                                                       Foreground="#FF607070" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.TempFR, Mode=OneWay}"
                                                   Foreground="#FFB0D0D0"
                                                   FontFamily="Consolas"
                                                   FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Rear row -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- RL -->
                                <Border Grid.Column="0"
                                        Background="#FF0F2020"
                                        BorderBrush="#FF2E4040"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TempIconRL, Mode=OneWay}"
                                                       FontSize="14"/>
                                            <TextBlock Text="Trasero Izq."
                                                       Foreground="#FF607070" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.TempRL, Mode=OneWay}"
                                                   Foreground="#FFB0D0D0"
                                                   FontFamily="Consolas"
                                                   FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- RR -->
                                <Border Grid.Column="1"
                                        Background="#FF0F2020"
                                        BorderBrush="#FF2E4040"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TempIconRR, Mode=OneWay}"
                                                       FontSize="14"/>
                                            <TextBlock Text="Trasero Der."
                                                       Foreground="#FF607070" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.TempRR, Mode=OneWay}"
                                                   Foreground="#FFB0D0D0"
                                                   FontFamily="Consolas"
                                                   FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Wheel slip card -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="💨 Deslizamiento de Ruedas  (FL/FR/RL/RR)"
                                       FontWeight="SemiBold"
                                       Foreground="#FFE0F0F0" FontSize="13"/>
                            <TextBlock Text="Valores altos en ruedas traseras = sobreviraje  |  altos en delanteras = subviraje"
                                       Foreground="#FF607070" FontSize="10"
                                       TextWrapping="Wrap"/>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FF0F2020"
                                        BorderBrush="#FF2E4040" BorderThickness="1"
                                        CornerRadius="6" Padding="8,6">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="FL" Foreground="#FF607070"
                                                   FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SlipFL, Mode=OneWay}"
                                                   Foreground="#FF00D4B4"
                                                   FontFamily="Consolas" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#FF0F2020"
                                        BorderBrush="#FF2E4040" BorderThickness="1"
                                        CornerRadius="6" Padding="8,6">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="FR" Foreground="#FF607070"
                                                   FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SlipFR, Mode=OneWay}"
                                                   Foreground="#FF00D4B4"
                                                   FontFamily="Consolas" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#FF0F2020"
                                        BorderBrush="#FF2E4040" BorderThickness="1"
                                        CornerRadius="6" Padding="8,6">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="RL" Foreground="#FF607070"
                                                   FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SlipRL, Mode=OneWay}"
                                                   Foreground="#FF00D4B4"
                                                   FontFamily="Consolas" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#FF0F2020"
                                        BorderBrush="#FF2E4040" BorderThickness="1"
                                        CornerRadius="6" Padding="8,6">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="RR" Foreground="#FF607070"
                                                   FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SlipRR, Mode=OneWay}"
                                                   Foreground="#FF00D4B4"
                                                   FontFamily="Consolas" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── RIGHT: AI Proposals ──────────────────────────────────────── -->
            <StackPanel Grid.Column="1" Spacing="10">

                <!-- Last analysis time -->
                <Border Background="#FF060E0E"
                        BorderBrush="#FF2E4040"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <TextBlock Text="{x:Bind ViewModel.LastAnalysisText, Mode=OneWay}"
                               Foreground="#FF607070"
                               FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Proposals card -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🤖 Propuestas IA — Telemetría"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE0F0F0" FontSize="14"/>
                        <TextBlock Text="Generadas automáticamente cada 3 s según el comportamiento del coche"
                                   Foreground="#FF607070" FontSize="11"
                                   TextWrapping="Wrap"/>

                        <ScrollViewer MaxHeight="340"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AiProposals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Proposal">
                                        <Border Margin="0,4"
                                                Padding="8,6"
                                                CornerRadius="6"
                                                Background="#FF0F2020"
                                                BorderBrush="#FF2E4040"
                                                BorderThickness="1">
                                            <StackPanel Spacing="2">
                                                <!-- Section › Parameter -->
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind Section}"
                                                               Foreground="#FF507070"
                                                               FontSize="10"
                                                               FontFamily="Consolas"/>
                                                    <TextBlock Text="›"
                                                               Foreground="#FF507070"
                                                               FontSize="10"/>
                                                    <TextBlock Text="{x:Bind Parameter}"
                                                               Foreground="#FFB0D0D0"
                                                               FontSize="12"
                                                               FontFamily="Consolas"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!-- From → To Δ -->
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind From}"
                                                               Foreground="#FF8AABAB"
                                                               FontSize="12"/>
                                                    <TextBlock Text="→"
                                                               Foreground="#FF607070"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{x:Bind To}"
                                                               Foreground="#FF00D4B4"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Delta}"
                                                               Foreground="#FF507070"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Reason -->
                                                <TextBlock Text="{x:Bind Reason}"
                                                           Foreground="#FF607070"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Feedback card -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🧠 Entrenar la Red Neuronal"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE0F0F0" FontSize="13"/>
                        <TextBlock Text="¿Fueron útiles las propuestas? Tu feedback mejora el análisis futuro."
                                   Foreground="#FF607070"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="✅ Útiles"
                                    Command="{x:Bind ViewModel.AcceptProposalsCommand}"
                                    Style="{StaticResource AccentActionButton}"
                                    HorizontalAlignment="Stretch"/>
                            <Button Content="❌ No útiles"
                                    Command="{x:Bind ViewModel.RejectProposalsCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- How it works card -->
                <Border Background="#FF0A1A14"
                        BorderBrush="#FF1E3828"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ℹ️ Cómo funciona"
                                   Foreground="#FF4A8A6A"
                                   FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="• AC debe estar en ejecución con una sesión activa."
                                   Foreground="#FF607060" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="• El análisis usa los últimos 6 s de telemetría."
                                   Foreground="#FF607060" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="• Carga un setup en la pestaña Sesiones para obtener valores concretos."
                                   Foreground="#FF607060" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="• Pulsa ✅/❌ para entrenar la red neuronal con tu opinión."
                                   Foreground="#FF607060" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ── Status bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#FF0A1414"
                BorderBrush="#FF2E4040"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="#FF00B4B4"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
