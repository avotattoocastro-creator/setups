<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AvoPerformanceSetupAI.Views.SesionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:AvoPerformanceSetupAI.ViewModels"
    xmlns:models="using:AvoPerformanceSetupAI.Models"
    Background="Transparent"
    RequestedTheme="Dark">

    <Page.DataContext>
        <vm:SessionsViewModel />
    </Page.DataContext>

    <Grid Margin="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             LEFT COLUMN: Config + Setups Table
             ══════════════════════════════════════════════ -->
        <StackPanel Grid.Column="0" Spacing="12">

            <!-- Config Card -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Labels -->
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Car ID" Foreground="#FF8AABAB" FontSize="11"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Track ID" Foreground="#FF8AABAB" FontSize="11"/>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Source" Foreground="#FF8AABAB" FontSize="11"/>
                    <TextBlock Grid.Column="3" Grid.Row="0" Text="Mode" Foreground="#FF8AABAB" FontSize="11"/>

                    <!-- Row 1: Values -->
                    <TextBox Grid.Column="0" Grid.Row="1"
                             Text="{Binding CarId, Mode=TwoWay}"
                             Background="#FF0F2020" Foreground="#FFE0F0F0"
                             BorderBrush="#FF2E4040"/>
                    <TextBox Grid.Column="1" Grid.Row="1"
                             Text="{Binding TrackId, Mode=TwoWay}"
                             Background="#FF0F2020" Foreground="#FFE0F0F0"
                             BorderBrush="#FF2E4040"/>
                    <ComboBox Grid.Column="2" Grid.Row="1"
                              ItemsSource="{Binding SetupSources}"
                              SelectedItem="{Binding SetupSource, Mode=TwoWay}"
                              MinWidth="120"/>
                    <ComboBox Grid.Column="3" Grid.Row="1"
                              ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding Mode, Mode=TwoWay}"
                              MinWidth="100"/>
                </Grid>
            </Border>

            <!-- Setups DataGrid -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <StackPanel>
                    <TextBlock Text="Setups" Foreground="#FFE0F0F0" FontWeight="SemiBold"
                               Margin="10,8,10,6"/>
                    <controls:DataGrid
                        x:Name="SetupsGrid"
                        ItemsSource="{Binding Iterations}"
                        AutoGenerateColumns="False"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        GridLinesVisibility="Horizontal"
                        HorizontalScrollBarVisibility="Auto"
                        MaxHeight="340"
                        Background="#FF0F1E1E"
                        Foreground="#FFE0F0F0"
                        RowBackground="#FF0F1E1E"
                        AlternatingRowBackground="#FF142424"
                        HeadersVisibility="Column">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Setup"    Binding="{Binding Setup}"   Width="*"    IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Best Lap" Binding="{Binding BestLap}" Width="110"  IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Iter"     Binding="{Binding Iter}"    Width="60"   IsReadOnly="True"/>
                            <controls:DataGridCheckBoxColumn Header="Exported" Binding="{Binding Exported}" Width="80" IsReadOnly="True"
                                                            x:Name="ExportedColumn"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </StackPanel>
            </Border>

            <!-- Action Buttons Row -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="▶ Start" Style="{StaticResource AccentActionButton}"
                        Command="{Binding StartStopCommand}"/>
                <Button Content="⏹ Stop"  Style="{StaticResource SecondaryActionButton}"
                        Command="{Binding StartStopCommand}"/>
                <Button Content="✔ Apply" Style="{StaticResource AccentActionButton}"
                        Command="{Binding ApplyCommand}"/>
                <Button Content="⚡ Connect" Style="{StaticResource SecondaryActionButton}"
                        Command="{Binding ConnectCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- ══════════════════════════════════════════════
             RIGHT COLUMN: Status + Brain + Proposals
             ══════════════════════════════════════════════ -->
        <StackPanel Grid.Column="1" Spacing="12">

            <!-- Status Card -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Status" Foreground="#FF8AABAB" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#FF00D4B4" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{Binding BrainInfo}" Foreground="#FF8AABAB" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- RUN Button -->
            <Button Content="⚡ RUN"
                    Style="{StaticResource RunButtonStyle}"
                    Command="{Binding StartStopCommand}"/>

            <!-- Last Proposal Card -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Last Proposal" FontWeight="SemiBold" Foreground="#FFE0F0F0"/>
                    <ItemsControl ItemsSource="{Binding LastProposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Proposal">
                                <Grid ColumnSpacing="8" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Parameter}" Foreground="#FFB0D0D0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind From}" Foreground="#FF8AABAB" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="→" Foreground="#FF8AABAB" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind To}" Foreground="#FF00D4B4" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Risk indicator -->
                    <Border Background="#FF0F2A1A" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Risk:" Foreground="#FF8AABAB" FontSize="12"/>
                            <TextBlock Text="{Binding RiskLevel}" Foreground="#FF00E676" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Proposal Action Buttons -->
            <StackPanel Spacing="8">
                <Button Content="✔ Apply Proposal"
                        Style="{StaticResource AccentActionButton}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ApplyProposalCommand}"/>
                <Button Content="↩ Rollback"
                        Style="{StaticResource SecondaryActionButton}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RollbackCommand}"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
