<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AvoPerformanceSetupAI.Views.ConfiguracionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    RequestedTheme="Dark">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="Configuración" FontSize="24" FontWeight="SemiBold" Foreground="#FFE0F0F0"/>
            <TextBlock Text="App settings and preferences will appear here." Foreground="#FF8AABAB"/>

            <!-- Language Selector -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Language / Idioma" FontWeight="SemiBold" Foreground="#FFE0F0F0"/>
                    <ComboBox Width="200" SelectedIndex="0">
                        <ComboBoxItem Content="Español (ES)" />
                        <ComboBoxItem Content="English (EN)" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Theme -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Theme / Tema" FontWeight="SemiBold" Foreground="#FFE0F0F0"/>
                    <ToggleSwitch Header="Dark Mode" IsOn="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
