<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AvoPerformanceSetupAI.Views.SetupDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AvoPerformanceSetupAI.Models"
    xmlns:vm="using:AvoPerformanceSetupAI.ViewModels"
    xmlns:converters="using:AvoPerformanceSetupAI.Converters"
    Background="{StaticResource CarbonBackgroundBrush}"
    RequestedTheme="Dark">

    <Page.Resources>
        <converters:DiffKindToColorConverter x:Key="DiffKindToColorConverter"/>
    </Page.Resources>

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Baseline -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Baseline" Foreground="#FF8AABAB" FontSize="11"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.SetupFiles}"
                              SelectedItem="{x:Bind ViewModel.BaselineFile, Mode=TwoWay}"
                              PlaceholderText="— select baseline —"
                              HorizontalAlignment="Stretch"
                              Background="#FF0F2020" Foreground="#FFE0F0F0"
                              BorderBrush="#FF2E4040"/>
                </StackPanel>

                <!-- Candidate -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Candidate" Foreground="#FF8AABAB" FontSize="11"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.SetupFiles}"
                              SelectedItem="{x:Bind ViewModel.CandidateFile, Mode=TwoWay}"
                              PlaceholderText="— select candidate —"
                              HorizontalAlignment="Stretch"
                              Background="#FF0F2020" Foreground="#FFE0F0F0"
                              BorderBrush="#FF2E4040"/>
                </StackPanel>

                <!-- Run button -->
                <Button Grid.Column="2"
                        Content="▶ Run Diff"
                        Style="{StaticResource AccentActionButton}"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RunDiffCommand}"/>

                <!-- Status -->
                <TextBlock Grid.Column="3"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Foreground="#FF8AABAB" FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ══ Group summary ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,10">
            <StackPanel Spacing="6">
                <TextBlock Text="Changes by Group" Foreground="#FF8AABAB" FontSize="11" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.GroupSummaries, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupSummaryRow">
                            <Border Background="#FF0F2A1A" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{x:Bind Display}"
                                           Foreground="#FF00D4B4" FontSize="12"
                                           FontFamily="Consolas" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══ Diff table ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Kind"      Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="1" Text="Group"     Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="2" Text="Parameter" Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="3" Text="Section"   Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="4" Text="Old"       Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="5" Text="New"       Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="6" Text="Δ"         Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="7" Text="Δ%"        Foreground="#FF607070" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"/>
                </Grid>

                <!-- Diff rows -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.DiffEntries, Mode=OneWay}"
                          Background="Transparent"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0,1"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SetupDiffEntry">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind KindDisplay}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{x:Bind Kind, Converter={StaticResource DiffKindToColorConverter}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Group}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#FF8AABAB"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Name}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#FFB0D8D8"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Section}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#FF607070"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind OldValueDisplay}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#FF8AABAB"/>
                                <TextBlock Grid.Column="5"
                                           Text="{x:Bind NewValueDisplay}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#FFE0F0F0"/>
                                <TextBlock Grid.Column="6"
                                           Text="{x:Bind DeltaDisplay}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#FF00D4B4"/>
                                <TextBlock Grid.Column="7"
                                           Text="{x:Bind DeltaPercentDisplay}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#FF8AABAB"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
