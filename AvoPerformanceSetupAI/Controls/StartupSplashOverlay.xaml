<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AvoPerformanceSetupAI.Controls.StartupSplashOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Storyboard x:Name="FadeOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="RootOverlay"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.0"
                Duration="0:0:0.350"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootOverlay">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0A1414" Offset="0.0"/>
                <GradientStop Color="#FF122020" Offset="0.6"/>
                <GradientStop Color="#FF0C1818" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <Image Source="ms-appx:///Assets/Brand/avo_performance.png"
                   Height="180" Stretch="Uniform"
                   HorizontalAlignment="Center"
                   AutomationProperties.Name="AVO Performance logo"/>
            <TextBlock x:Name="StatusTextBlock"
                       HorizontalAlignment="Center"
                       Foreground="#FFE0F0F0"
                       FontSize="14"
                       FontFamily="Consolas"/>
            <ProgressRing x:Name="Ring"
                          IsActive="True"
                          Width="32" Height="32"
                          Foreground="#FF00B4B4"
                          HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
